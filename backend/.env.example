# ============================================================================
# COALGUARD AI BACKEND CONFIGURATION (SUPABASE + WEBSOCKETS)
# ============================================================================

# Application Environment ('development' or 'production')
NODE_ENV=development

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=8080

# Supabase Credentials (Found in Supabase Dashboard -> Project Settings -> API)
# 1. Project URL:
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
# 2. Project API Key (anon public key or service_role secret key for backend):
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxxxxxxxxxxxxxx

# CORS Allowed Origin (Point to your frontend URL or comma-separated list)
# e.g., http://localhost:5173,https://coalguard-frontend.onrender.com
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Telemetry Broadcast Frequency (in milliseconds)
TELEMETRY_INTERVAL_MS=1200

# Optional Hardware Relay / MQTT Broker URL
MQTT_BROKER_URL=mqtt://broker.emqx.io:1883
