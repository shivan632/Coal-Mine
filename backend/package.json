{
  "name": "coalguard-backend",
  "version": "1.0.0",
  "description": "COALGUARD AI Underground Coal Mine Safety Command Center — Backend Server (Node.js, Express, TypeScript, Supabase, WebSockets)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seeds/seedDatabase.ts",
    "render-build": "npm install && npm run build"
  },
  "keywords": [
    "coal-mine-safety",
    "iot-telemetry",
    "dgms-compliance",
